class Solution {

    // Function to rotate the array to the left by 'k' positions
    public void rotate(int[] nums, int k) {

        int i;

        // Loop until all k rotations are done
        while (k > 0) {

            // Step 1: Store the first element temporarily
            int temp = nums[0]; // ⏳ Save the first element

            // Step 2: Shift all elements one position to the left
            for (i = 1; i < nums.length; i++) {
                nums[i - 1] = nums[i]; // 👉 Move current element to previous position
            }

            // Step 3: Move the saved first element to the last position
            nums[i - 1] = temp; // 🔁 Put first element at the end

            // Step 4: One rotation done, reduce k
            k--; // 🔄 Decrease the count of remaining rotations
        }
    }
}
Input: nums = [1, 2, 3, 4, 5], k = 2

After 1st rotation: [2, 3, 4, 5, 1]
After 2nd rotation: [3, 4, 5, 1, 2]

Output: [3, 4, 5, 1, 2]
